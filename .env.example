# ---- EVM (Polygon Amoy testnet chainId 80002 / Polygon mainnet 137) ----
EVM_DEPLOYER_PRIVATE_KEY=<preencher>
EVM_DEPLOYER_ADDRESS=<preencher>
EVM_RELAYER_PRIVATE_KEY=<preencher>
EVM_RELAYER_ADDRESS=<preencher>
EVM_SAFE_SIGNER_1_PRIVATE_KEY=<preencher>
EVM_SAFE_SIGNER_1_ADDRESS=<preencher>
EVM_SAFE_SIGNER_2_PRIVATE_KEY=<preencher>
EVM_SAFE_SIGNER_2_ADDRESS=<preencher>
EVM_SAFE_SIGNER_3_PRIVATE_KEY=<preencher>
EVM_SAFE_SIGNER_3_ADDRESS=<preencher>
EVM_SAFE_ADDRESS=<preencher>
EVM_SAFE_THRESHOLD=2

# ---- RPCs ----
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_AMOY_RPC_URL_FALLBACK=https://polygon-amoy-bor-rpc.publicnode.com
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGONSCAN_API_KEY=<polygonscan-api-key>

# ---- Solana (devnet) ----
SOLANA_DEPLOYER_SECRET_KEY=<preencher>
SOLANA_DEPLOYER_ADDRESS=<preencher>
SOLANA_RELAYER_SECRET_KEY=<preencher>
SOLANA_RELAYER_ADDRESS=<preencher>
SOLANA_RPC_URL=https://api.devnet.solana.com

# ---- Stellar (testnet) ----
STELLAR_DEPLOYER_SECRET=<preencher>
STELLAR_DEPLOYER_ADDRESS=<preencher>
STELLAR_RELAYER_SECRET=<preencher>
STELLAR_RELAYER_ADDRESS=<preencher>
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ---- Enderecos de contratos/programas (preenchidos apos deploys) ----
EVM_RAPPORT_ORACLE_ADDRESS=<preencher>
SOLANA_RAPPORT_ORACLE_PROGRAM_ID=
STELLAR_RAPPORT_ORACLE_CONTRACT_ID=

# ---- Cloudflare (preencher para deploy do middleware) ----
CLOUDFLARE_API_TOKEN=<preencher>
CLOUDFLARE_ACCOUNT_ID=<cloudflare-account-id>
MIDDLEWARE_URL=<workers-dev-url>
